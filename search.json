---
layout: null
permalink: /search.json
sitemap: false
---
{% assign entries = site.posts | concat: site.notes | sort: 'date' | reverse %}
[
{% for entry in entries %}
  {
    "title": {{ entry.title | jsonify }},
    "url": {{ entry.url | relative_url | jsonify }},
    "description": {{ entry.description | default: '' | jsonify }},
    "date": {{ entry.date | date: '%Y.%m.%d' | jsonify }},
    "displayDate": {{ entry.date | date: '%b %-d, %Y' | jsonify }},
    "datetime": {{ entry.date | date_to_xmlschema | jsonify }},
    "updated": {{ entry.last_modified_at | date: '%Y.%m.%d' | jsonify }},
    "updateNote": {{ entry.update_note | default: '' | jsonify }},
    "kind": {{ entry.kind | default: 'article' | jsonify }},
    "topic": {{ entry.subcategory | default: entry.categories.first | default: '' | jsonify }},
    "tags": {{ entry.tags | jsonify }},
    "status": {{ entry.status | default: '' | jsonify }},
    "content": {{ entry.content | markdownify | strip_html | normalize_whitespace | jsonify }}
  }{% unless forloop.last %},{% endunless %}
{% endfor %}
]
